function flyToCart(srcEl, imgUrl) {
  const cartBtn = $('#cartBtn');
  if (!srcEl || !cartBtn || !imgUrl) return;
  const sRect = srcEl.getBoundingClientRect();
  const cRect = cartBtn.getBoundingClientRect();
  const clone = document.createElement('div');
  clone.className = 'fly-clone';
  clone.style.backgroundImage = 'url('+imgUrl+')';
  clone.style.left = (sRect.left + sRect.width/2 - 30) + 'px';
  clone.style.top  = (sRect.top  + sRect.height/2 - 30) + 'px';
  document.body.appendChild(clone);
  requestAnimationFrame(() => {
    clone.style.transform = 'translate('+(cRect.left - sRect.left + cRect.width/2 - sRect.width/2)+'px, '+(cRect.top - sRect.top + cRect.height/2 - sRect.height/2)+'px) scale(.25)';
    clone.style.opacity = '0.2';
  });
  setTimeout(() => { try { clone.remove(); } catch (e) {} }, 750);
}

