<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --primary:#e91e63;--secondary:#4a148c;--accent:#f8bbd0;
  --text-dark:#2d0066;--text-mid:#7b1fa2;--text-soft:#94a3b8;
  --bg-soft:#fef7fb;--bg-soft2:#f7f0ff;
  --error:#d32f2f;--success:#2e7d32;--warning:#f57c00;--info:#0277bd;
  --shadow-sm:0 2px 4px rgba(0,0,0,.06);--shadow:0 4px 15px rgba(233,30,99,.15);
  --shadow-lg:0 8px 30px rgba(233,30,99,.25);--shadow-xl:0 20px 50px rgba(0,0,0,.15);
  --radius:14px;--transition:all .25s cubic-bezier(.4,0,.2,1);
}
html{scroll-behavior:smooth}
body{font-family:'Segoe UI',-apple-system,BlinkMacSystemFont,system-ui,sans-serif;line-height:1.6;
  color:var(--text-dark);background:linear-gradient(135deg,#fce4ec 0%,#f3e5f5 100%);
  min-height:100vh;overflow-x:hidden;padding-bottom:60px}
.container{max-width:1400px;margin:0 auto}

.tc-bar{background:#0f172a;color:#cbd5e1;text-align:center;padding:6px 12px;
  font-size:11px;letter-spacing:.4px;font-weight:500;position:relative;z-index:50}
.tc-bar b{color:#fff}
.tc-bar a{color:#7dd3fc;text-decoration:none;margin-left:6px}

.announce-bar{background:linear-gradient(135deg,var(--secondary),var(--primary));color:#fff;
  text-align:center;padding:7px 12px;font-size:13px;font-weight:500}

header{background:rgba(255,255,255,.97);backdrop-filter:blur(8px);box-shadow:var(--shadow);
  position:sticky;top:0;z-index:1000;border-bottom:3px solid var(--primary)}
nav{display:flex;justify-content:space-between;align-items:center;padding:.85rem 5%;
  max-width:1500px;margin:0 auto;flex-wrap:wrap;gap:1rem}
.logo{font-size:1.6rem;font-weight:800;color:var(--primary);text-decoration:none;
  display:flex;align-items:center;gap:10px;letter-spacing:-.5px;cursor:pointer}
.logo i{font-size:1.8rem}
.logo img{height:42px;width:auto;border-radius:8px;object-fit:contain;max-width:160px}
.nav-links{display:flex;list-style:none;gap:1.5rem;align-items:center;flex-wrap:wrap}
.nav-links a{text-decoration:none;color:var(--text-dark);font-weight:500;
  transition:var(--transition);padding:6px 0;border-bottom:2px solid transparent;cursor:pointer;font-size:14px}
.nav-links a:hover{color:var(--primary);border-bottom-color:var(--primary)}
.search-bar{display:flex;align-items:center;background:var(--accent);border-radius:25px;
  padding:9px 18px;min-width:220px;border:2px solid transparent;transition:var(--transition);gap:8px}
.search-bar:focus-within{border-color:var(--primary);background:#fff}
.search-bar input{border:0;background:transparent;width:100%;outline:0;font-size:14px}
.search-bar i{color:var(--text-mid);font-size:14px}
.nav-icons{display:flex;gap:.6rem;align-items:center}
.icon-btn{background:0 0;border:0;font-size:1.25rem;color:var(--text-dark);cursor:pointer;
  position:relative;transition:var(--transition);padding:7px;border-radius:50%;width:40px;height:40px;
  display:flex;align-items:center;justify-content:center}
.icon-btn:hover{color:var(--primary);background:var(--accent);transform:scale(1.05)}
.badge{position:absolute;top:-4px;right:-4px;background:var(--error);color:#fff;
  border-radius:50%;min-width:20px;height:20px;padding:0 4px;font-size:10px;
  display:flex;align-items:center;justify-content:center;font-weight:700;border:2px solid #fff}
.user-menu{position:relative}
.user-dropdown{position:absolute;top:48px;right:0;background:#fff;border-radius:12px;
  box-shadow:0 10px 30px rgba(0,0,0,.15);min-width:240px;display:none;overflow:hidden;z-index:1100}
.user-dropdown.active{display:block;animation:slideDown .2s ease}
.user-dropdown a,.user-dropdown button{display:flex;align-items:center;gap:10px;
  padding:11px 16px;color:var(--text-dark);text-decoration:none;border:0;
  background:0 0;width:100%;text-align:left;font-size:14px;cursor:pointer;font-family:inherit}
.user-dropdown a:hover,.user-dropdown button:hover{background:var(--accent);color:var(--primary)}
.user-welcome{padding:14px 16px;background:linear-gradient(135deg,var(--secondary),var(--primary));color:#fff}
.user-welcome strong{display:block;font-size:14px}
.user-welcome small{display:block;opacity:.85;font-size:11px;margin-top:2px}
.tier-badge{display:inline-flex;align-items:center;gap:4px;padding:2px 10px;border-radius:12px;
  font-size:10px;font-weight:600;margin-top:6px;background:rgba(255,255,255,.2);color:#fff}
.points-pill{background:rgba(255,255,255,.2);padding:6px 10px;border-radius:8px;
  font-size:11px;margin-top:8px;display:flex;justify-content:space-between;align-items:center}
.mobile-menu-btn{display:none;background:0 0;border:0;font-size:1.5rem;cursor:pointer;color:var(--text-dark)}

/* HERO SLIDER */
.hero-slider{position:relative;height:500px;overflow:hidden;background:linear-gradient(135deg,var(--secondary),var(--primary))}
.hero-slide{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  background-size:cover;background-position:center;opacity:0;transition:opacity .8s ease;
  flex-direction:column;text-align:center;padding:0 5%;color:#fff}
.hero-slide.active{opacity:1;z-index:2}
.hero-slide::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(74,20,140,.55),rgba(233,30,99,.55))}
.hero-content{position:relative;z-index:1;max-width:800px}
.hero-content h1{font-size:3.2rem;margin-bottom:1rem;text-shadow:2px 2px 6px rgba(0,0,0,.4);font-weight:800;line-height:1.1}
