async function loadProfile() {
  const host = $('#profileContent');
  if (!host) return;

  if (!state.currentUser) {
    host.innerHTML = '<div class="empty-state"><i class="fas fa-user"></i><h3>Sign in to view your profile</h3>' +
      '<button class="btn-primary" data-open="loginModal" style="margin-top:1rem">' +
      '<i class="fas fa-sign-in-alt"></i> Login</button></div>';
    return;
  }

  host.innerHTML = '<div class="loading"><i class="fas fa-spinner"></i><p>Loading your profile…</p></div>';

  const [full, dash] = await Promise.all([
    apiCall('get_customer_profile'),
    apiCall('get_customer_dashboard')
  ]);

  if (!full || !full.success) {
    host.innerHTML = '<div class="empty-state"><i class="fas fa-triangle-exclamation"></i>' +
      '<h3>Could not load your profile</h3><p>' +
      safeText((full && full.error && full.error.message) || 'Please try again.') + '</p>' +
      '<button class="btn-primary" style="margin-top:1rem" onclick="loadProfile()">' +
