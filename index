  background:linear-gradient(90deg,var(--primary),var(--secondary));border-radius:2px}
.section-title small{font-size:.7em;color:var(--text-mid);font-weight:500;margin-left:8px}
.section-actions{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;margin-bottom:1rem}

/* PRODUCTS */
.products-toolbar{display:flex;justify-content:space-between;align-items:center;
  flex-wrap:wrap;gap:1rem;margin-bottom:1.4rem;padding:1rem;background:linear-gradient(135deg,#fef7fb,#f3e5f5);border-radius:12px}
.toolbar-left{display:flex;gap:.7rem;align-items:center;flex-wrap:wrap;flex:1}
.toolbar-right{display:flex;gap:.7rem;align-items:center;flex-wrap:wrap}
.category-filter{display:flex;gap:.5rem;flex-wrap:wrap}
.category-btn{padding:7px 16px;border:2px solid #ddd;border-radius:20px;background:#fff;
  cursor:pointer;font-size:13px;font-weight:500;transition:var(--transition);color:var(--text-mid);font-family:inherit}
.category-btn:hover,.category-btn.active{background:var(--primary);color:#fff;border-color:var(--primary)}
.sort-select{padding:7px 14px;border-radius:20px;border:2px solid #ddd;background:#fff;font-size:13px;font-family:inherit;cursor:pointer}
.sort-select:focus{outline:0;border-color:var(--primary)}
.price-range{display:flex;gap:6px;align-items:center;font-size:13px;color:var(--text-mid)}
.price-range input{width:80px;padding:5px 10px;border:1px solid #ddd;border-radius:14px;font-size:12px;font-family:inherit}

.products-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(245px,1fr));gap:1.4rem}
.product-card{background:#fff;border-radius:var(--radius);box-shadow:var(--shadow-sm);
  overflow:hidden;transition:var(--transition);position:relative;display:flex;flex-direction:column}
.product-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-lg)}
.product-image-container{position:relative;width:100%;aspect-ratio:1/1;
  background:linear-gradient(135deg,#f5f0ff,#ffe0ef);overflow:hidden;cursor:pointer}
.product-image{width:100%;height:100%;object-fit:cover;transition:transform .4s ease;display:block}
.product-card:hover .product-image{transform:scale(1.07)}
.image-placeholder{width:100%;height:100%;display:flex;flex-direction:column;align-items:center;
  justify-content:center;color:var(--text-mid);font-size:13px;gap:8px}
.image-placeholder i{font-size:2.6rem;opacity:.4}
.product-corner{position:absolute;top:10px;display:flex;align-items:center;gap:6px;z-index:2}
.corner-tl{left:10px}.corner-tr{right:10px;flex-direction:column}
.product-tag{padding:3px 9px;border-radius:10px;font-size:10px;font-weight:700;color:#fff;letter-spacing:.3px}
.tag-stock-in{background:var(--success)}
.tag-stock-out{background:var(--error)}
.tag-sale{background:#ff5722}
.tag-new{background:var(--info)}
.tag-featured{background:linear-gradient(135deg,#ffd700,#ffa000);color:#000}
.heart-btn{background:rgba(255,255,255,.95);border:0;width:34px;height:34px;border-radius:50%;
  cursor:pointer;color:var(--primary);font-size:1rem;display:flex;align-items:center;justify-content:center;
  box-shadow:0 2px 8px rgba(0,0,0,.15);transition:var(--transition);font-family:inherit}
.heart-btn:hover{transform:scale(1.1);background:#fff}
.heart-btn.active{background:var(--primary);color:#fff}
.heart-btn.active i{font-weight:900}
.quickview-btn{background:rgba(0,0,0,.7);color:#fff;border:0;padding:6px 12px;border-radius:14px;
  font-size:11px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:5px;
  position:absolute;bottom:10px;left:50%;transform:translate(-50%, 20px);opacity:0;transition:var(--transition);
  font-family:inherit}
.product-card:hover .quickview-btn{transform:translate(-50%, 0);opacity:1}
.product-info{padding:1rem;display:flex;flex-direction:column;gap:.5rem;flex:1}
.product-cat{font-size:10px;font-weight:600;color:var(--text-mid);text-transform:uppercase;letter-spacing:.4px}
.product-name{font-size:1rem;font-weight:700;color:var(--text-dark);line-height:1.3;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;cursor:pointer}
.product-name:hover{color:var(--primary)}
.product-rating{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-mid)}
.product-rating .stars{color:#fbc02d;letter-spacing:1px}
.product-price{font-size:1.2rem;font-weight:800;color:var(--primary);margin-top:auto;display:flex;align-items:center;gap:8px}
.product-price .old{font-size:.85rem;color:var(--text-soft);text-decoration:line-through;font-weight:400}
.add-to-cart-btn{margin-top:.5rem;padding:11px;background:var(--primary);color:#fff;border:0;
  border-radius:25px;cursor:pointer;font-size:13px;font-weight:600;transition:var(--transition);
  display:flex;align-items:center;justify-content:center;gap:8px;font-family:inherit}
.add-to-cart-btn:hover:not(:disabled){background:var(--secondary);transform:scale(1.02)}
.add-to-cart-btn:disabled{background:#bbb;cursor:not-allowed}
.add-to-cart-btn.adding{background:var(--info)}
.add-to-cart-btn.added{background:var(--success);transform:scale(1.05)}

.fly-clone{position:fixed;width:60px;height:60px;border-radius:50%;background-size:cover;background-position:center;
  background-repeat:no-repeat;z-index:9999;pointer-events:none;box-shadow:0 8px 24px rgba(0,0,0,.3);
  transition:transform .7s cubic-bezier(.5,-.5,1,1),opacity .7s ease}

/* CART SIDEBAR */
.cart-overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1500;
  opacity:0;visibility:hidden;transition:opacity .25s ease}
.cart-overlay.active{opacity:1;visibility:visible}
.cart-sidebar{position:fixed;top:0;right:-460px;width:440px;max-width:100vw;height:100vh;
  background:#fff;box-shadow:-10px 0 30px rgba(0,0,0,.18);z-index:1600;
  transition:right .3s cubic-bezier(.4,0,.2,1);display:flex;flex-direction:column}
.cart-sidebar.active{right:0}
.cart-header{padding:1.2rem;background:linear-gradient(135deg,var(--secondary),var(--primary));
  color:#fff;display:flex;justify-content:space-between;align-items:center}
.cart-header h2{font-size:1.2rem;display:flex;align-items:center;gap:10px}
.cart-close{background:rgba(255,255,255,.18);border:0;color:#fff;width:34px;height:34px;
  border-radius:50%;cursor:pointer;font-size:1.4rem;display:flex;align-items:center;justify-content:center;font-family:inherit}
.cart-items{flex:1;overflow-y:auto;padding:1rem}
.empty-cart{text-align:center;padding:3rem 1rem;color:var(--text-mid)}
.empty-cart i{font-size:3.5rem;opacity:.3;display:block;margin-bottom:1rem}
.cart-item{display:grid;grid-template-columns:70px 1fr auto;gap:.8rem;padding:.8rem;
  background:#fff;border:1px solid #eee;border-radius:10px;margin-bottom:.7rem;align-items:center;animation:slideIn .25s ease}
.cart-item-image{width:70px;height:70px;border-radius:8px;overflow:hidden;
  background:linear-gradient(135deg,#f5f0ff,#ffe0ef);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.cart-item-image img{width:100%;height:100%;object-fit:cover;display:block}
.cart-item-image i{color:var(--text-mid);font-size:1.5rem}
.cart-item-details{min-width:0}
.cart-item-name{font-size:13px;font-weight:600;color:var(--text-dark);
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-bottom:2px}
.cart-item-price{font-size:14px;font-weight:700;color:var(--primary);margin-bottom:6px}
.quantity-controls{display:flex;align-items:center;gap:8px;background:#f5f5f5;padding:3px;border-radius:20px;width:fit-content}
.qty-btn{width:28px;height:28px;border-radius:50%;border:0;background:#fff;color:var(--primary);cursor:pointer;font-size:1.1rem;
  font-weight:700;display:flex;align-items:center;justify-content:center;box-shadow:0 1px 3px rgba(0,0,0,.1);
  transition:transform .1s ease,background .15s ease;-webkit-tap-highlight-color:transparent;font-family:inherit}
.qty-btn:hover:not(:disabled){background:var(--primary);color:#fff;transform:scale(1.08)}
.qty-btn:active{transform:scale(.92)}
.qty-btn:disabled{opacity:.5;cursor:not-allowed}
.qty-display{min-width:24px;text-align:center;font-weight:700;font-size:14px;color:var(--text-dark)}
.cart-item-remove{background:#ffebee;color:var(--error);border:0;width:32px;height:32px;border-radius:50%;
  cursor:pointer;display:flex;align-items:center;justify-content:center;transition:var(--transition);flex-shrink:0;font-family:inherit}
.cart-item-remove:hover:not(:disabled){background:var(--error);color:#fff;transform:scale(1.1)}
.cart-item-remove:disabled{opacity:.5;cursor:not-allowed}
.cart-coupon{display:flex;gap:6px;padding:1rem;border-top:1px dashed #eee;background:#fafafa}
.cart-coupon input{flex:1;padding:8px 12px;border:1px solid #ddd;border-radius:20px;font-size:13px;font-family:inherit}
.cart-coupon button{padding:8px 16px;border:0;background:var(--primary);color:#fff;border-radius:20px;cursor:pointer;font-weight:600;font-size:12px;font-family:inherit}
.coupon-applied{background:#e8f5e9;border-radius:8px;padding:8px 12px;margin:8px 1rem 0;
