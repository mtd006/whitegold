      if (state.currentUser) state.currentUser.name = name;
      renderUserMenu();
      showToast('success', 'Profile updated');
      accAlert('accProfileAlert', 'success', 'Your details have been saved.');
      loadProfile();
    } else {
      accAlert('accProfileAlert', 'error', (res && res.error && res.error.message) || 'Could not save your details');
    }
  });
}

function accAlert(hostId, type, msg) {
  const el = $('#' + hostId);
  if (!el) return;
  const ok = type === 'success';
  el.style.display = 'block';
  el.innerHTML = '<div style="padding:.65rem .85rem;border-radius:9px;font-size:13px;' +
    'background:' + (ok ? '#dcfce7' : '#fee2e2') + ';color:' + (ok ? '#166534' : '#991b1b') + '">' +
