async function trackOrder(orderId) {
  openModal('trackModal');
  $('#trackContent').innerHTML = '<div class="loading"><i class="fas fa-spinner"></i><p>Loading tracking…</p></div>';
  
  // Fetch tracking and documents in parallel
  const [res, docsRes] = await Promise.all([
    apiCall('track_order', { orderId, customerId: state.currentUser ? state.currentUser.id : null }),
    apiCall('get_order_documents', { orderId })
  ]);
  
  if (!res.success) {
    $('#trackContent').innerHTML = '<p style="text-align:center;color:var(--error);padding:2rem">'+safeText((res.error && res.error.message) || 'Could not load tracking')+'</p>';
    return;
  }
  const d = res.data;
  const order = d.order, history = d.history || [], shipping = d.shipping, progress = d.progress;
  const pct = progress.currentStep < 0 ? 0 : ((progress.currentStep / Math.max(1, progress.steps.length - 1)) * 100);
  const icons = ['box','check','box-open','truck','dolly','flag-checkered'];
  const stepsHtml = progress.steps.map((s,i) => {
    const done = i < progress.currentStep, cur = i === progress.currentStep;
    return '<div class="track-step '+(done?'done':'')+' '+(cur?'current':'')+'">'+
      '<div class="dot"><i class="fas fa-'+(icons[i]||'circle')+'"></i></div>'+
      '<div class="lbl">'+safeText(s)+'</div></div>';
  }).join('');
  
  // Documents section
  const docs = (docsRes && docsRes.success && docsRes.data.documents) ? docsRes.data.documents : [];
  const docTypeIcons = {
    'Courier Receipt': 'receipt', 'Proof of Delivery': 'check-circle', 'Invoice Copy': 'file-invoice',
    'Return Slip': 'undo', 'Tracking Document': 'truck', 'Other': 'paperclip'
  };
  const docsHtml = docs.length ? `
    <h4 style="margin-top:1.2rem;color:var(--secondary)">📎 Attached Documents (${docs.length})</h4>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:.5rem;margin-top:.5rem">
      ${docs.map(doc => `
        <a href="${safeText(doc.FileURL||'#')}" target="_blank" rel="noopener" style="display:flex;gap:.5rem;align-items:center;padding:.6rem;border:1px solid #eee;border-radius:8px;background:#fff;text-decoration:none;color:var(--text);transition:all .15s">
          <div style="width:36px;height:36px;border-radius:8px;background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0">
            <i class="fas fa-${docTypeIcons[doc.DocumentType]||'paperclip'}"></i>
          </div>
          <div style="min-width:0;flex:1">
            <div style="font-weight:600;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${safeText(doc.FileName||'Document')}</div>
            <div style="font-size:11px;color:var(--text-mid)">${safeText(doc.DocumentType||'')} · ${(parseInt(doc.FileSize||0)/1024).toFixed(0)} KB</div>
            ${doc.Description ? `<div style="font-size:11px;color:var(--text-mid);margin-top:2px">${safeText(doc.Description)}</div>` : ''}
          </div>
          <i class="fas fa-external-link-alt" style="font-size:12px;color:var(--text-mid)"></i>
        </a>
      `).join('')}
    </div>` : '';
  
  $('#trackContent').innerHTML =
    '<div style="background:#fff8f9;border-radius:10px;padding:1rem;margin-bottom:1rem">'+
      '<div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:.5rem">'+
        '<div><b>Order:</b> '+safeText(order.OrderID)+'</div>'+
        '<div><b>Date:</b> '+(order.OrderDate ? new Date(order.OrderDate).toLocaleDateString('en-IN') : '')+'</div>'+
        '<div><b>Status:</b> <span class="order-status '+String(order.Status||'').toLowerCase().replace(/\s+/g,'-')+'">'+safeText(order.Status||'')+'</span></div>'+
        '<div><b>Total:</b> '+fmtMoney(order.TotalAmount||0)+'</div>'+
      '</div>'+
      (order.TrackingNumber ? '<div style="margin-top:.5rem;font-size:13px;color:var(--text-mid)"><b>Tracking #:</b> '+safeText(order.TrackingNumber)+'</div>' : '')+
    '</div>'+
    '<div class="tracking-progress" style="--progress:'+pct+'%">'+stepsHtml+'</div>'+
    (shipping ?
      '<div style="background:#fff;border:1px solid #eee;border-radius:10px;padding:1rem;margin-top:1rem">'+
        '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:.5rem;font-size:13px">'+
          (shipping.partner ? '<div><b>Partner:</b> '+safeText(shipping.partner)+'</div>' : '')+
          (shipping.docket ? '<div><b>Docket:</b> '+safeText(shipping.docket)+'</div>' : '')+
          (shipping.expected ? '<div><b>Expected:</b> '+(new Date(shipping.expected)).toLocaleDateString('en-IN')+'</div>' : '')+
          (shipping.delivered ? '<div><b>Delivered:</b> '+(new Date(shipping.delivered)).toLocaleDateString('en-IN')+'</div>' : '')+
        '</div>'+
        (shipping.trackingURL ? '<div style="margin-top:.6rem"><a href="'+safeText(shipping.trackingURL)+'" target="_blank" class="btn-action"><i class="fas fa-external-link-alt"></i> Open courier tracking</a></div>' : '')+
      '</div>' : '')+
    docsHtml +
    '<h4 style="margin-top:1.2rem;color:var(--secondary)">Order History</h4>'+
    '<div class="track-history">'+
      (history.length ? history.map(h => '<div class="row"><div class="when">'+(new Date(h.timestamp)).toLocaleString('en-IN')+'</div><div class="what"><b>'+safeText(h.status||'')+'</b></div></div>').join('') : '<p style="color:var(--text-mid);font-size:13px">No history yet</p>')+
    '</div>';
}

