function accWirePersonal() {
  const btn = $('#apSave');
  if (!btn) return;
  btn.addEventListener('click', async () => {
    const name = $('#apName').value.trim();
    if (name.length < 2) return accAlert('accProfileAlert', 'error', 'Please enter your full name');

    const phone = $('#apPhone').value.trim();
    if (phone && !/^[\d\s+()-]{7,20}$/.test(phone)) {
      return accAlert('accProfileAlert', 'error', 'Please enter a valid mobile number');
    }

    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving…';

    const res = await apiCall('update_my_profile', {
      profile: {
        name:       name,
        phone:      phone,
        phone2:     $('#apPhone2').value.trim(),
        address:    $('#apAddress').value.trim(),
        city:       $('#apCity').value.trim(),
        state:      $('#apState').value.trim(),
        pincode:    $('#apPincode').value.trim(),
        country:    $('#apCountry').value.trim(),
        dob:        $('#apDob').value,
        gender:     $('#apGender').value,
        newsletter: $('#apNews').checked,
        smsOptIn:   $('#apSms').checked
      }
    });

    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-floppy-disk"></i> Save Changes';

