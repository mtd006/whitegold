function getProductLocal(id) { return state.products.find(p => String(p.ID) === String(id)); }

// ============== WISHLIST ==============
async function loadWishlist() {
  if (!state.currentUser) {
    state.wishlist.clear();
    $('#wishlistBadge').style.display = 'none';
    renderWishlistPage();
    return;
  }
  const res = await apiCall('get_wishlist', { customerId: state.currentUser.id });
  state.wishlist.clear();
  if (res.success && res.data && Array.isArray(res.data.wishlist)) {
    res.data.wishlist.forEach(w => state.wishlist.add(String(w.productId)));
  }
  const badge = $('#wishlistBadge');
  if (state.wishlist.size > 0) {
    badge.textContent = state.wishlist.size; badge.style.display = 'flex';
  } else { badge.style.display = 'none'; }
  $$('.heart-btn').forEach(btn => {
    const pid = btn.dataset.wishlist;
    const isIn = state.wishlist.has(String(pid));
    btn.classList.toggle('active', isIn);
    const ic = btn.querySelector('i');
    if (ic) ic.className = (isIn ? 'fas' : 'far') + ' fa-heart';
  });
  renderWishlistPage();
}

async function toggleWishlist(productId, btnEl) {
  if (!state.currentUser) {
    showToast('warning','Please login to use wishlist');
    openModal('loginModal'); return;
  }
  const pid = String(productId);
  const isIn = state.wishlist.has(pid);
  // Optimistic
  if (isIn) { state.wishlist.delete(pid); }
  else      { state.wishlist.add(pid); }
  if (btnEl) {
    btnEl.classList.toggle('active', !isIn);
    const ic = btnEl.querySelector('i'); if (ic) ic.className = (!isIn ? 'fas' : 'far') + ' fa-heart';
  }
  $('#wishlistBadge').textContent = state.wishlist.size;
  $('#wishlistBadge').style.display = state.wishlist.size ? 'flex' : 'none';
  
  const action = isIn ? 'remove_from_wishlist' : 'add_to_wishlist';
  const res = await apiCall(action, { customerId: state.currentUser.id, productId: pid });
  if (!res.success) {
    // rollback
    if (isIn) state.wishlist.add(pid); else state.wishlist.delete(pid);
    if (btnEl) btnEl.classList.toggle('active', isIn);
    showToast('error','Could not update wishlist');
    return;
  }
  if (!isIn) showATCToast('Added to wishlist', '');
  renderWishlistPage();
}

function renderWishlistPage() {
  $('#wishlistCount').textContent = state.wishlist.size ? '('+state.wishlist.size+' items)' : '';
  const grid = $('#wishlistGrid');
