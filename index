function accWireSecurity() {
  const np = $('#apNewPwd');
  if (np) {
    np.addEventListener('input', e => {
      const v = e.target.value;
      let s = 0;
      if (v.length >= 6) s++;
      if (v.length >= 10) s++;
      if (/[a-z]/.test(v) && /[A-Z]/.test(v)) s++;
      if (/\d/.test(v) && /[^A-Za-z0-9]/.test(v)) s++;
      const colors = ['#ef4444', '#f59e0b', '#3b82f6', '#10b981'];
      $$('.ap-bar').forEach((b, i) => b.style.background = i < s ? colors[Math.max(s, 1) - 1] : '#e5e7eb');
      $('#apPwdHint').textContent = v ? ['Too weak', 'Weak', 'Good', 'Strong', 'Excellent'][s] : 'At least 6 characters.';
    });
  }

  const btn = $('#apPwdSave');
  if (!btn) return;
  btn.addEventListener('click', async () => {
    const cur = $('#apOldPwd').value, nw = $('#apNewPwd').value, cf = $('#apNewPwd2').value;
    if (!cur) return accAlert('accPwdAlert', 'error', 'Enter your current password');
    if (nw.length < 6) return accAlert('accPwdAlert', 'error', 'New password must be at least 6 characters');
    if (nw !== cf) return accAlert('accPwdAlert', 'error', 'New passwords do not match');

    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Updating…';

    const res = await apiCall('change_my_password', {
      currentPassword: cur, newPassword: nw, confirmPassword: cf
    });

    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-key"></i> Change Password';

    if (res && res.success) {
      $('#apOldPwd').value = $('#apNewPwd').value = $('#apNewPwd2').value = '';
      $$('.ap-bar').forEach(b => b.style.background = '#e5e7eb');
      accAlert('accPwdAlert', 'success', 'Password changed successfully.');
      showToast('success', 'Password updated');
    } else {
      accAlert('accPwdAlert', 'error', (res && res.error && res.error.message) || 'Could not change password');
    }
  });
}

