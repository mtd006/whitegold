async function loadProductReviews(productId) {
  const res = await apiCall('get_reviews', { productId });
  if (!res.success || !res.data) return;
  const reviews = res.data.reviews || [];
  const summary = res.data.summary || {};
  
  // Cache rating
  const p = getProductLocal(productId);
  if (p) { p._rating = summary.averageRating; p._ratingCount = summary.totalRatings; }
  
  const dist = summary.distribution || {};
  const total = summary.totalRatings || 0;
  let summaryHtml = '';
  if (total > 0) {
    summaryHtml =
      '<div class="reviews-summary">'+
        '<div class="review-avg">'+
          '<div class="num">'+summary.averageRating.toFixed(1)+'</div>'+
          '<div class="stars">'+renderStars(summary.averageRating)+'</div>'+
          '<small>Based on '+total+' review'+(total>1?'s':'')+'</small>'+
        '</div>'+
        '<div class="rating-bars">'+
          [5,4,3,2,1].map(s => {
            const count = dist[s] || 0;
            const pct = total > 0 ? (count / total * 100) : 0;
            return '<div class="rating-bar"><span>'+s+' star</span>'+
              '<div class="rating-bar-track"><div class="rating-bar-fill" style="width:'+pct+'%"></div></div>'+
              '<span>'+count+'</span></div>';
          }).join('')+
        '</div>'+
      '</div>';
  }
  
  let listHtml = '';
  if (reviews.length === 0) {
    listHtml = '<p style="color:var(--text-mid);text-align:center;padding:1rem">No reviews yet. Be the first!</p>';
  } else {
    listHtml = reviews.slice(0, 10).map(r =>
      '<div class="review-item">'+
        '<div class="review-head">'+
          '<div>'+
            '<span class="review-author">'+safeText(r.ClientName)+
              (String(r.Verified)==='true' ? '<span class="verified"><i class="fas fa-check-circle"></i> Verified Buyer</span>' : '')+
            '</span>'+
          '</div>'+
          '<div class="review-stars">'+renderStars(r.Rating)+'</div>'+
        '</div>'+
        '<div class="review-date">'+new Date(r.SubmittedDate).toLocaleDateString('en-IN')+'</div>'+
        (r.Title ? '<div class="review-title">'+safeText(r.Title)+'</div>' : '')+
        '<div class="review-comment">'+safeText(r.Comment||'')+'</div>'+
        (r.AdminReply ? '<div class="review-reply"><b>Store Reply:</b> '+safeText(r.AdminReply)+'</div>' : '')+
      '</div>').join('');
  }
  $('#qvReviewsContent').innerHTML = summaryHtml + listHtml;
  
  // Update rating display in quick view header
  const qvR = $('#qvRating');
  if (qvR) qvR.innerHTML = renderStars(summary.averageRating||0) + ' <small>('+total+' reviews)</small>';
}

