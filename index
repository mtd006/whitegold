// ============== CART (DOM-diff, optimistic, no flicker) ==============
function computeTotals() {
  let subtotal = 0, tax = 0, shipping = 0, qty = 0;
  for (const it of state.cart.itemsByCartId.values()) {
    const q = Number(it.quantity || 0);
    const p = Number(it.price || 0);
    const s = p * q;
    subtotal += s;
    tax      += s * (Number((it.product && it.product.TaxRate) || 0) / 100);
    shipping += Number((it.product && it.product.ShippingCharge) || 0) * q;
    qty      += q;
  }
  // Free shipping
  const freeOver = parseFloat(state.config.shippingFreeOver || 0);
  if (freeOver > 0 && subtotal >= freeOver) shipping = 0;
  
  const discount = state.couponDiscount || 0;
  state.cart.totals = { subtotal, tax, shipping, discount, total: Math.max(0, subtotal + tax + shipping - discount), qty };
}

function updateCartSummary() {
  computeTotals();
  $('#cartBadge').textContent = String(state.cart.totals.qty || 0);
  const t = state.cart.totals;
  let sub = '';
  if (state.cart.itemsByCartId.size > 0) {
    sub = '<div class="row"><span>Subtotal:</span><span>'+fmtMoney(t.subtotal)+'</span></div>'+
          '<div class="row"><span>Tax:</span><span>'+fmtMoney(t.tax)+'</span></div>'+
          '<div class="row"><span>Shipping:</span><span>'+(t.shipping === 0 ? '<span style="color:var(--success);font-weight:600">FREE</span>' : fmtMoney(t.shipping))+'</span></div>';
    if (t.discount > 0) sub += '<div class="row discount"><span><i class="fas fa-tag"></i> Discount:</span><span>-'+fmtMoney(t.discount)+'</span></div>';
  }
  $('#cartSubtotals').innerHTML = sub;
  $('#cartTotal').textContent = fmtMoney(t.total);
  $('#checkoutBtnCart').disabled = state.cart.itemsByCartId.size === 0;
  $('#cartCouponBlock').style.display = state.cart.itemsByCartId.size > 0 ? 'flex' : 'none';
  
  if (state.appliedCoupon) {
    $('#cartCouponApplied').innerHTML =
      '<div class="coupon-applied">'+
      '<span><i class="fas fa-check-circle"></i> Coupon <b>'+safeText(state.appliedCoupon.code)+'</b> applied (-'+fmtMoney(state.couponDiscount)+')</span>'+
      '<button class="x" id="removeCouponBtn">&times;</button></div>';
  } else {
    $('#cartCouponApplied').innerHTML = '';
  }
}

function cartItemEl(cartId) {
  return $('#cartItems .cart-item[data-cart-id="'+CSS.escape(String(cartId))+'"]');
}

function buildCartItemNode(item) {
  const cartId = String(item.cartId);
  const name = (item.product && item.product.Name) || 'Product';
  const imgUrl = (item.product && (item.product.DisplayURL || item.product.ImageURL)) || '';
  const img = imgUrl ? convertGDriveLink(imgUrl) : '';
  const el = document.createElement('div');
  el.className = 'cart-item';
  el.dataset.cartId = cartId;
  el.dataset.productId = String((item.product && item.product.ID) || '');
  el.innerHTML =
    '<div class="cart-item-image">'+
      (img ? '<img src="'+safeText(img)+'" alt="'+safeText(name)+'" loading="lazy">' : '<i class="fas fa-gem"></i>')+
    '</div>'+
    '<div class="cart-item-details">'+
      '<div class="cart-item-name">'+safeText(name)+'</div>'+
      '<div class="cart-item-price">'+fmtMoney(item.price)+'</div>'+
      '<div class="quantity-controls">'+
        '<button class="qty-btn" data-qty="dec" aria-label="Decrease">&minus;</button>'+
        '<span class="qty-display">'+safeText(item.quantity)+'</span>'+
        '<button class="qty-btn" data-qty="inc" aria-label="Increase">+</button>'+
      '</div>'+
    '</div>'+
    '<button class="cart-item-remove" data-remove="1" aria-label="Remove"><i class="fas fa-trash-alt"></i></button>';
  return el;
}

function renderCart() {
  const wrap = $('#cartItems');
  if (state.cart.itemsByCartId.size === 0) {
    wrap.innerHTML = '<div class="empty-cart"><i class="fas fa-shopping-cart"></i><p>Your cart is empty</p></div>';
    state.appliedCoupon = null; state.couponDiscount = 0;
    updateCartSummary();
    return;
  }
  // Diff: remove orphan nodes
  const existing = new Set();
  $$('#cartItems .cart-item').forEach(n => existing.add(n.dataset.cartId));
  for (const id of existing) {
    if (!state.cart.itemsByCartId.has(id)) { const node = cartItemEl(id); if (node) node.remove(); }
  }
  const empty = wrap.querySelector('.empty-cart'); if (empty) empty.remove();
  for (const [cartId, item] of state.cart.itemsByCartId.entries()) {
    let node = cartItemEl(cartId);
    if (!node) {
      node = buildCartItemNode(item);
      wrap.appendChild(node);
    } else {
      const qty = node.querySelector('.qty-display');
      if (qty && qty.textContent !== String(item.quantity)) qty.textContent = String(item.quantity);
      const price = node.querySelector('.cart-item-price');
      if (price) price.textContent = fmtMoney(item.price);
    }
  }
  updateCartSummary();
}

function setItemControlsDisabled(cartId, disabled) {
  const node = cartItemEl(cartId);
  if (!node) return;
  $$('.qty-btn,.cart-item-remove', node).forEach(b => b.disabled = !!disabled);
}

async function loadCart() {
  if (!state.currentUser) return;
  const res = await apiCall('get_cart_items', { customerId: state.currentUser.id });
  if (!res.success) {
    showToast('error', (res.error && res.error.message) || 'Could not load cart');
    return;
  }
  state.cart.itemsByCartId.clear();
  state.cart.indexByProductId.clear();
  (res.data.items || []).forEach(it => {
    const cartId = String(it.cartId);
    state.cart.itemsByCartId.set(cartId, {
      cartId,
      quantity: Number(it.quantity || 0),
      price: Number(it.price || (it.product && it.product.Price) || 0),
      product: it.product || null
    });
    if (it.product && it.product.ID) state.cart.indexByProductId.set(String(it.product.ID), cartId);
  });
  renderCart();
}

async function addToCart(productId, btnEl) {
  if (!state.currentUser) {
    showToast('warning','Please login to add to cart');
    openModal('loginModal');
    return;
  }
  const p = getProductLocal(productId);
  if (!p) return showToast('error','Product not found');
  if ((Number(p.Stock) || 0) <= 0) return showToast('warning','Out of stock');

  if (btnEl) {
    btnEl.classList.add('adding');
    btnEl.disabled = true;
    btnEl.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Adding…';
  }
  const imgUrl = (p.DisplayURL || p.ImageURL) ? convertGDriveLink(p.DisplayURL || p.ImageURL) : '';
  showATCToast(p.Name, imgUrl);
  if (btnEl && imgUrl) {
    const card = btnEl.closest('.product-card');
    const imgEl = card && card.querySelector('.product-image, .image-placeholder');
    flyToCart(imgEl || btnEl, imgUrl);
  }

  // Optimistic state
  const pid = String(productId);
  const existingCartId = state.cart.indexByProductId.get(pid);
  let optimisticId = existingCartId, createdPending = false;
  if (existingCartId && state.cart.itemsByCartId.has(existingCartId)) {
    state.cart.itemsByCartId.get(existingCartId).quantity += 1;
  } else {
    optimisticId = 'pending:' + pid;
    createdPending = true;
    state.cart.itemsByCartId.set(optimisticId, {
      cartId: optimisticId, quantity: 1, price: Number(p.Price || 0), product: p
    });
    state.cart.indexByProductId.set(pid, optimisticId);
  }
  renderCart();

  const res = await apiCall('add_to_cart', { customerId: state.currentUser.id, productId: pid, quantity: 1 });

  if (res.success) {
    if (createdPending && res.data && res.data.cartId) {
      const item = state.cart.itemsByCartId.get(optimisticId);
      state.cart.itemsByCartId.delete(optimisticId);
      const realId = String(res.data.cartId);
      item.cartId = realId;
      state.cart.itemsByCartId.set(realId, item);
      state.cart.indexByProductId.set(pid, realId);
      const node = cartItemEl(optimisticId);
      if (node) node.dataset.cartId = realId;
    }
  } else {
    if (createdPending) {
      state.cart.itemsByCartId.delete(optimisticId);
      state.cart.indexByProductId.delete(pid);
    } else if (existingCartId) {
      const it = state.cart.itemsByCartId.get(existingCartId);
      if (it) it.quantity = Math.max(1, it.quantity - 1);
    }
    renderCart();
    showToast('error', (res.error && res.error.message) || 'Could not add to cart');
  }

  if (btnEl) {
    btnEl.classList.remove('adding');
    btnEl.classList.add('added');
    btnEl.innerHTML = '<i class="fas fa-check"></i> Added!';
    setTimeout(() => {
      btnEl.classList.remove('added');
      btnEl.disabled = false;
      btnEl.innerHTML = '<i class="fas fa-cart-plus"></i> Add to Cart';
    }, 900);
  }
}

async function changeQty(cartId, delta) {
  const id = String(cartId);
  const item = state.cart.itemsByCartId.get(id);
  if (!item) return;
  if (id.indexOf('pending:') === 0) { showToast('info','Syncing…'); return; }
  const prev = Number(item.quantity || 1);
  const next = prev + delta;

  setItemControlsDisabled(id, true);
  if (next <= 0) {
    state.cart.itemsByCartId.delete(id);
    const pid = String((item.product && item.product.ID) || '');
    if (pid && state.cart.indexByProductId.get(pid) === id) state.cart.indexByProductId.delete(pid);
    renderCart();
    const r = await apiCall('remove_from_cart', { cartId: id });
    if (!r.success) {
      state.cart.itemsByCartId.set(id, item);
      if (pid) state.cart.indexByProductId.set(pid, id);
      renderCart();
      showToast('error','Could not remove item');
    } else { showToast('info','Item removed'); }
    return;
  }
  item.quantity = next;
  renderCart();
  const r = await apiCall('update_cart_quantity', { cartId: id, quantity: next });
  if (!r.success) {
    item.quantity = prev;
    renderCart();
    showToast('error','Could not update quantity');
  }
  setItemControlsDisabled(id, false);
}

async function removeCartItem(cartId) {
  const id = String(cartId);
  const item = state.cart.itemsByCartId.get(id);
  if (!item) return;
  if (id.indexOf('pending:') === 0) {
    state.cart.itemsByCartId.delete(id);
    const pid = String((item.product && item.product.ID) || '');
    if (pid && state.cart.indexByProductId.get(pid) === id) state.cart.indexByProductId.delete(pid);
    renderCart();
    return;
  }
  setItemControlsDisabled(id, true);
  state.cart.itemsByCartId.delete(id);
  const pid = String((item.product && item.product.ID) || '');
  if (pid && state.cart.indexByProductId.get(pid) === id) state.cart.indexByProductId.delete(pid);
  renderCart();
  const r = await apiCall('remove_from_cart', { cartId: id });
  if (!r.success) {
    state.cart.itemsByCartId.set(id, item);
    if (pid) state.cart.indexByProductId.set(pid, id);
    renderCart();
    showToast('error','Could not remove item');
  } else { showToast('info','Item removed'); }
}

function toggleCart(force) {
  const open = $('#cartSidebar').classList.contains('active');
  const next = (typeof force === 'boolean') ? force : !open;
  $('#cartSidebar').classList.toggle('active', next);
  $('#cartOverlay').classList.toggle('active', next);
}

// ============== COUPON ==============
async function applyCoupon() {
  const code = $('#cartCouponCode').value.trim();
  if (!code) return showToast('error','Enter a coupon code');
  computeTotals();
  const res = await apiCall('validate_coupon', {
    code, subtotal: state.cart.totals.subtotal,
    customerId: state.currentUser ? state.currentUser.id : ''
  });
  if (res.success && res.data && res.data.valid) {
    state.appliedCoupon = res.data.coupon;
    state.couponDiscount = res.data.discount;
    $('#cartCouponCode').value = '';
    showToast('success', res.message || 'Coupon applied!');
    updateCartSummary();
  } else {
    showToast('error', (res.error && res.error.message) || res.message || 'Invalid coupon');
  }
}
function removeCoupon() {
  state.appliedCoupon = null; state.couponDiscount = 0;
  updateCartSummary();
  showToast('info','Coupon removed');
}

// ============== CHECKOUT ==============
function setPaymentMethod(method) {
  state.paymentMethod = method;
  $('#checkoutPayment').value = method;
  $$('.payment-option', $('#paymentMethods')).forEach(o => o.classList.toggle('active', o.dataset.payment === method));
  $('#cardDetailsSection').classList.toggle('show', method === 'Card');
  $('#upiDetailsSection').classList.toggle('show', method === 'UPI');
}

function refreshCheckoutSummary() {
  computeTotals();
  const t = state.cart.totals;
  $('#checkoutSubtotal').textContent = fmtMoney(t.subtotal);
  $('#checkoutTax').textContent      = fmtMoney(t.tax);
  $('#checkoutShipping').textContent = t.shipping === 0 ? 'FREE' : fmtMoney(t.shipping);
  
  const couponD = state.appliedCoupon ? state.couponDiscount : 0;
  if (couponD > 0) { $('#couponDiscountRow').style.display='flex'; $('#checkoutCouponDisc').textContent='-'+fmtMoney(couponD); }
  else { $('#couponDiscountRow').style.display='none'; }
  
  let groupD = 0;
  if (state.customerGroup && state.customerGroup.tier && parseFloat(state.customerGroup.tier.DiscountPercent||0) > 0) {
    groupD = t.subtotal * (parseFloat(state.customerGroup.tier.DiscountPercent) / 100);
    $('#groupDiscountRow').style.display='flex';
    $('#checkoutGroupDisc').textContent = '-'+fmtMoney(groupD);
  } else { $('#groupDiscountRow').style.display='none'; }
  
  let ptsD = 0;
  const ptsRedeeming = parseInt($('#ptsSlider').value || 0);
  if (ptsRedeeming > 0) {
    ptsD = ptsRedeeming * (state.loyalty.rupeePerPoint || 0.25);
    $('#ptsDiscountRow').style.display='flex';
    $('#checkoutPtsDisc').textContent = '-'+fmtMoney(ptsD);
  } else { $('#ptsDiscountRow').style.display='none'; }
  
  const total = Math.max(0, t.subtotal + t.tax + t.shipping - couponD - groupD - ptsD);
  $('#checkoutTotal').textContent = fmtMoney(total);
}

function openCheckout() {
  if (!state.currentUser) { showToast('warning','Please login'); openModal('loginModal'); return; }
  if (state.cart.itemsByCartId.size === 0) { showToast('warning','Cart is empty'); return; }
  $('#checkoutAddress').value = state.currentUser.address || '';
  setPaymentMethod(state.paymentMethod || 'COD');
  
  // Loyalty redeem block
  if (state.loyalty.balance > 0 && state.config.enableLoyalty !== 'false') {
