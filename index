}

function accPanelLoyalty(l) {
  return '<h4 style="color:var(--secondary);margin-bottom:.7rem"><i class="fas fa-coins"></i> Loyalty Activity</h4>' +
    '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:.6rem;margin-bottom:1rem">' +
      '<div style="padding:.8rem;background:linear-gradient(135deg,#f59e0b,#d97706);color:#fff;border-radius:9px;text-align:center">' +
      '<b style="font-size:1.4rem">' + (l.balance || 0) + '</b><br><small style="opacity:.85">Current Points</small></div>' +
      '<div style="padding:.8rem;background:#dcfce7;color:#166534;border-radius:9px;text-align:center">' +
      '<b style="font-size:1.4rem">' + (l.totalEarned || 0) + '</b><br><small>Total Earned</small></div>' +
      '<div style="padding:.8rem;background:#fee2e2;color:#991b1b;border-radius:9px;text-align:center">' +
      '<b style="font-size:1.4rem">' + (l.totalRedeemed || 0) + '</b><br><small>Total Redeemed</small></div>' +
    '</div>' +
    ((l.ledger && l.ledger.length)
      ? '<div style="overflow-x:auto;border-radius:9px;border:1px solid #eee">' +
        '<table style="width:100%;border-collapse:collapse;font-size:13px;background:#fff">' +
        '<thead><tr style="background:#f8fafc"><th style="text-align:left;padding:.6rem">Date</th>' +
        '<th style="text-align:left;padding:.6rem">Type</th><th style="text-align:right;padding:.6rem">Points</th>' +
        '<th style="text-align:right;padding:.6rem">Balance</th><th style="text-align:left;padding:.6rem">Reason</th>' +
        '</tr></thead><tbody>' +
        l.ledger.map(e => {
          const earn = String(e.Type || '').toLowerCase() === 'earn';
          return '<tr style="border-bottom:1px solid #f3f4f6">' +
            '<td style="padding:.6rem">' + fmtDate(e.Date) + '</td>' +
            '<td style="padding:.6rem"><span style="padding:2px 8px;border-radius:10px;font-size:11px;font-weight:600;' +
            (earn ? 'background:#dcfce7;color:#166534">EARN' : 'background:#fef3c7;color:#92400e">REDEEM') + '</span></td>' +
            '<td style="padding:.6rem;text-align:right;font-weight:700;color:' + (earn ? '#10b981' : '#ef4444') + '">' +
            (earn ? '+' : '-') + (e.Points || 0) + '</td>' +
            '<td style="padding:.6rem;text-align:right">' + (e.Balance || 0) + '</td>' +
            '<td style="padding:.6rem"><small>' + safeText(e.Reason || '-') + '</small></td></tr>';
        }).join('') + '</tbody></table></div>'
      : '<p style="text-align:center;color:var(--text-mid);padding:1.5rem">No loyalty activity yet — start shopping to earn points!</p>');
}

function accPanelReviews(f) {
  const reviews = f.reviews || [];
  return '<h4 style="color:var(--secondary);margin-bottom:.7rem"><i class="fas fa-star"></i> My Reviews</h4>' +
    (reviews.length
      ? reviews.map(r => {
          const n = parseInt(r.Rating || 0, 10) || 0;
          return '<div style="border:1px solid #eee;border-radius:9px;padding:.8rem;margin-bottom:.5rem">' +
            '<div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.5rem">' +
            '<span style="color:#fbbf24;letter-spacing:2px">' + '★'.repeat(n) + '☆'.repeat(5 - n) + '</span>' +
            '<small style="color:var(--text-mid)">' + fmtDate(r.SubmittedDate) + '</small></div>' +
            (r.Title ? '<div style="font-weight:600;margin-top:.3rem">' + safeText(r.Title) + '</div>' : '') +
            '<div style="font-size:13px;margin-top:.3rem">' + safeText(r.Comment || '') + '</div>' +
            '<small style="color:var(--text-mid)">Product: ' + safeText(r.ProductID || '') + '</small></div>';
        }).join('')
      : '<p style="text-align:center;color:var(--text-mid);padding:1.5rem">You have not left any reviews yet</p>');
}


// ============== EVENTS ==============
function attachEvents() {
  $('#cartBtn').addEventListener('click', () => toggleCart(true));
  $('#cartCloseBtn').addEventListener('click', () => toggleCart(false));
  $('#cartOverlay').addEventListener('click', () => toggleCart(false));
  $('#checkoutBtnCart').addEventListener('click', openCheckout);
  $('#userBtn').addEventListener('click', e => { e.stopPropagation(); closeMobileNav(); $('#userDropdown').classList.toggle('active'); });
  document.addEventListener('click', e => {
    if (!e.target.closest('.user-menu')) $('#userDropdown').classList.remove('active');
    // Tapping anywhere outside the open mobile menu closes it
    if (!e.target.closest('#navLinks') && !e.target.closest('#mobileMenuBtn')) closeMobileNav();
  });
  $('#mobileMenuBtn').addEventListener('click', e => {
    e.stopPropagation();
    $('#userDropdown').classList.remove('active');
    const open = $('#navLinks').classList.toggle('mobile-active');
    setMobileMenuIcon(open);
  });
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      $('#userDropdown').classList.remove('active');
      closeMobileNav();
    }
  });
  window.addEventListener('resize', () => { if (window.innerWidth > 880) closeMobileNav(); });
  $('#loginForm').addEventListener('submit', handleLogin);
  $('#registerForm').addEventListener('submit', handleRegister);
  $('#adminLoginForm').addEventListener('submit', handleAdminLogin);
  $('#forgotForm').addEventListener('submit', handleForgot);
  $('#resetForm').addEventListener('submit', handleReset);
  $('#checkoutForm').addEventListener('submit', handleCheckout);
  $('#complaintForm').addEventListener('submit', submitComplaint);
  $('#contactForm').addEventListener('submit', submitContact);
  $('#reviewForm').addEventListener('submit', submitReview);
  $('#returnForm').addEventListener('submit', submitReturn);
  $('#newsletterForm').addEventListener('submit', async e => {
    e.preventDefault();
    const ok = await subscribeNewsletter($('#newsletterEmail').value.trim(), 'contact-page');
    if (ok) $('#newsletterForm').reset();
  });
  $('#footerNewsForm').addEventListener('submit', async e => {
    e.preventDefault();
    const ok = await subscribeNewsletter($('#footerNewsEmail').value.trim(), 'footer');
    if (ok) $('#footerNewsForm').reset();
  });
  $('#applyCouponBtn').addEventListener('click', applyCoupon);
  $('#cartCouponCode').addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); applyCoupon(); } });
  
  $('#cardNumber').addEventListener('input', formatCardInput);
  $('#cardCvv').addEventListener('input', e => { e.target.value = e.target.value.replace(/\D/g,'').slice(0,4); });
  $('#cardExpiryMonth').addEventListener('input', e => { e.target.value = e.target.value.replace(/\D/g,'').slice(0,2); });
  $('#cardExpiryYear').addEventListener('input', e => { e.target.value = e.target.value.replace(/\D/g,'').slice(0,2); });
  $('#adminPin').addEventListener('input', e => { e.target.value = e.target.value.replace(/\D/g,'').slice(0,6); });
  
  $('#ptsSlider').addEventListener('input', e => {
    $('#ptsRedeeming').textContent = e.target.value;
    refreshCheckoutSummary();
  });
  
  setupOtpInputs();
  setupStarInput();

  let searchTimer;
  $('#searchInput').addEventListener('input', e => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => { state.searchQuery = e.target.value; renderProducts(); renderHomeFeatured(); }, 200);
  });
  
  $('#sortSelect').addEventListener('change', e => { state.sortBy = e.target.value; renderProducts(); });
  $('#priceMin').addEventListener('input', e => {
    state.priceMin = e.target.value ? parseFloat(e.target.value) : null;
    renderProducts();
  });
  $('#priceMax').addEventListener('input', e => {
    state.priceMax = e.target.value ? parseFloat(e.target.value) : null;
    renderProducts();
  });

  // Hero slider arrows + dots
  $('#heroSlider').addEventListener('click', e => {
    const arr = e.target.closest('[data-slider]');
    if (arr) {
      goHeroSlide(state.heroIndex + (arr.dataset.slider === 'next' ? 1 : -1));
      startHeroAutoplay();
      return;
    }
    const dot = e.target.closest('[data-hero-go]');
    if (dot) {
      goHeroSlide(parseInt(dot.dataset.heroGo));
      startHeroAutoplay();
      return;
    }
    const link = e.target.closest('[data-banner-link]');
    if (link) {
      const url = link.dataset.bannerLink;
      if (url === '#products' || !url) { showPage('products'); }
      else if (url.startsWith('#')) { showPage(url.slice(1)); }
      else { window.open(url, '_blank'); }
    }
  });

  document.body.addEventListener('click', e => {
    const atc = e.target.closest('[data-add-to-cart]');
    if (atc) { e.preventDefault(); addToCart(atc.dataset.addToCart, atc); return; }
    
    const wl = e.target.closest('[data-wishlist]');
    if (wl) { e.preventDefault(); toggleWishlist(wl.dataset.wishlist, wl); return; }
    
    const qBtn = e.target.closest('.qty-btn');
    if (qBtn) {
      const ci = qBtn.closest('.cart-item');
      if (ci && ci.dataset.cartId) changeQty(ci.dataset.cartId, qBtn.dataset.qty === 'inc' ? 1 : -1);
      return;
    }
    const rmBtn = e.target.closest('[data-remove]');
    if (rmBtn) {
      const ci = rmBtn.closest('.cart-item');
      if (ci && ci.dataset.cartId) removeCartItem(ci.dataset.cartId);
      return;
    }
    
    const removeCoup = e.target.closest('#removeCouponBtn');
    if (removeCoup) { removeCoupon(); return; }
    
    const qv = e.target.closest('[data-quickview]');
    if (qv) { e.preventDefault(); openQuickView(qv.dataset.quickview); return; }
    
    const writeRev = e.target.closest('[data-write-review]');
    if (writeRev) { openReviewForm(writeRev.dataset.writeReview); return; }
    const reviewProd = e.target.closest('[data-review-prod]');
    if (reviewProd) { openReviewForm(reviewProd.dataset.reviewProd); return; }
    
    const nav = e.target.closest('[data-nav]');
    if (nav) { e.preventDefault(); showPage(nav.dataset.nav); $('#userDropdown').classList.remove('active'); return; }
    const open = e.target.closest('[data-open]');
    if (open) { e.preventDefault(); openModal(open.dataset.open); $('#userDropdown').classList.remove('active'); return; }
    const lo = e.target.closest('[data-logout]');
    if (lo) { e.preventDefault(); handleLogout(); return; }
    const ad = e.target.closest('[data-admin]');
    if (ad) { e.preventDefault(); openAdminDashboard(); return; }
    const cat = e.target.closest('[data-category]');
    if (cat) { state.activeCategory = cat.dataset.category; renderCategoryFilters(); renderProducts(); return; }
    const pm = e.target.closest('.payment-option');
    if (pm) { setPaymentMethod(pm.dataset.payment); return; }
    const tk = e.target.closest('[data-track]'); if (tk) { trackOrder(tk.dataset.track); return; }
    const rd = e.target.closest('[data-reorder]'); if (rd) { reorder(rd.dataset.reorder); return; }
    const iv = e.target.closest('[data-invoice]'); if (iv) { downloadInvoice(iv.dataset.invoice); return; }
    const rt = e.target.closest('[data-return]'); if (rt) { openReturnModal(rt.dataset.return); return; }
  });
}

async function init() {
  attachEvents();
  await loadBusinessConfig();
  await Promise.all([loadHeroBanners(), loadTrustBadges(), loadProducts()]);
  await checkSession();
}
document.addEventListener('DOMContentLoaded', init);
</script>

