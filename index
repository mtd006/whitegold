function accSetTab(tab) {
  if (!$('#ppanel-' + tab)) tab = 'personal';
  ACC.tab = tab;
  $$('.profile-tab').forEach(b => {
    const on = b.dataset.ptab === tab;
    b.style.borderBottomColor = on ? 'var(--primary)' : 'transparent';
