  const rating = p._rating || 0;
  const ratingCount = p._ratingCount || 0;
  
  return '<div class="product-card" data-product-id="'+safeText(pid)+'">'+
    '<div class="product-image-container" data-quickview="'+safeText(pid)+'">'+
      '<div class="product-corner corner-tl">'+
        '<span class="product-tag '+(inStock?'tag-stock-in':'tag-stock-out')+'">'+(inStock ? 'In Stock' : 'Out of Stock')+'</span>'+
      '</div>'+
      '<div class="product-corner corner-tr">'+
        '<button class="heart-btn '+(inWishlist?'active':'')+'" data-wishlist="'+safeText(pid)+'" title="Wishlist">'+
        '<i class="'+(inWishlist?'fas':'far')+' fa-heart"></i></button>'+
      '</div>'+
      (img
        ? '<img src="'+safeText(img)+'" alt="'+safeText(p.Name||'')+'" class="product-image" loading="lazy" onerror="this.outerHTML=\'<div class=&quot;image-placeholder&quot;><i class=&quot;fas fa-gem&quot;></i><span>No image</span></div>\'">'
        : '<div class="image-placeholder"><i class="fas fa-gem"></i><span>No image</span></div>')+
      '<button class="quickview-btn" data-quickview="'+safeText(pid)+'"><i class="fas fa-eye"></i> Quick View</button>'+
    '</div>'+
    '<div class="product-info">'+
      (p.Category ? '<div class="product-cat">'+safeText(p.Category)+'</div>' : '')+
      '<h3 class="product-name" data-quickview="'+safeText(pid)+'">'+safeText(p.Name || 'Product')+'</h3>'+
      (rating > 0 || ratingCount > 0 ? '<div class="product-rating"><span class="stars">'+renderStars(rating)+'</span><small>('+ratingCount+')</small></div>' : '')+
      '<div class="product-price">'+fmtMoney(p.Price)+'</div>'+
      '<button class="add-to-cart-btn" data-add-to-cart="'+safeText(pid)+'" '+(!inStock?'disabled':'')+'>'+
        '<i class="fas fa-'+(inStock?'cart-plus':'times-circle')+'"></i> '+
        (inStock?'Add to Cart':'Out of Stock')+
      '</button>'+
    '</div>'+
  '</div>';
}

function applyFiltersAndSort(list) {
  const q = state.searchQuery.toLowerCase().trim();
  let result = list.slice();
  if (state.activeCategory !== 'all') result = result.filter(p => (p.Category||'') === state.activeCategory);
  if (q) result = result.filter(p =>
    String(p.Name||'').toLowerCase().indexOf(q) !== -1 ||
    String(p.Description||'').toLowerCase().indexOf(q) !== -1 ||
    String(p.Category||'').toLowerCase().indexOf(q) !== -1);
  if (state.priceMin != null) result = result.filter(p => parseFloat(p.Price||0) >= state.priceMin);
  if (state.priceMax != null) result = result.filter(p => parseFloat(p.Price||0) <= state.priceMax);
  
  const sb = state.sortBy;
  if (sb === 'price-asc') result.sort((a,b) => parseFloat(a.Price||0) - parseFloat(b.Price||0));
  else if (sb === 'price-desc') result.sort((a,b) => parseFloat(b.Price||0) - parseFloat(a.Price||0));
  else if (sb === 'name-asc') result.sort((a,b) => String(a.Name||'').localeCompare(b.Name||''));
  else if (sb === 'name-desc') result.sort((a,b) => String(b.Name||'').localeCompare(a.Name||''));
  else if (sb === 'rating') result.sort((a,b) => (b._rating||0) - (a._rating||0));
  else if (sb === 'newest') result.sort((a,b) => String(b.ID||'').localeCompare(a.ID||''));
  return result;
}

function renderProducts() {
  const list = applyFiltersAndSort(state.products);
  const html = list.length
    ? list.map(productCardHtml).join('')
