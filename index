async function handleCheckout(e) {
  e.preventDefault();
  if (!state.currentUser) return;
  const method = state.paymentMethod;
  let card = null, upiId = null;
  if (method === 'Card') {
    const num = String($('#cardNumber').value || '').replace(/\s/g,'');
    const cvv = String($('#cardCvv').value || '');
    const mm = String($('#cardExpiryMonth').value || '');
    const yy = String($('#cardExpiryYear').value || '');
    if (num.length < 13 || num.length > 19) return showToast('error','Enter a valid card number');
    if (cvv.length < 3) return showToast('error','Enter a valid CVV');
    if (!mm || !yy) return showToast('error','Enter card expiry');
    card = { cardName: String($('#cardName').value || ''), last4: num.slice(-4),
             expiryMonth: mm, expiryYear: yy };
  }
  if (method === 'UPI') {
    upiId = String($('#upiId').value || '').trim();
    if (!upiId || !/^[\w.\-]+@[\w]+$/.test(upiId)) return showToast('error','Enter a valid UPI ID');
  }
  const ptsRedeeming = parseInt($('#ptsSlider').value || 0);
  const btn = $('#placeOrderBtn');
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Placing Order…';
  const res = await apiCall('place_order_v4', {
    customerId: state.currentUser.id,
    paymentMethod: method,
    shippingAddress: $('#checkoutAddress').value,
    cardDetails: card,
    upiId: upiId,
    couponCode: state.appliedCoupon ? state.appliedCoupon.code : '',
    redeemPoints: ptsRedeeming
  });
  btn.disabled = false;
  btn.innerHTML = '<i class="fas fa-check-circle"></i> Place Order';
  if (res.success) {
    closeModal('checkoutModal');
    let msg = 'Order placed! ID: ' + res.data.orderId;
    if (res.data.pointsEarned > 0) msg += ' (+' + res.data.pointsEarned + ' points!)';
    showToast('success', msg);
    state.cart.itemsByCartId.clear();
    state.cart.indexByProductId.clear();
    state.appliedCoupon = null; state.couponDiscount = 0;
    renderCart();
    await loadLoyalty();
    await loadCustomerGroup();
    renderUserMenu();
    showPage('orders');
    loadOrders();
  } else {
    showToast('error', (res.error && res.error.message) || 'Failed to place order');
  }
}

function formatCardInput() {
  let v = String($('#cardNumber').value || '').replace(/\D/g,'').slice(0,19);
  v = v.replace(/(.{4})/g, '$1 ').trim();
  $('#cardNumber').value = v;
}

