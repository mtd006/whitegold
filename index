  if (banners.length === 0) {
    banners = [{ Title: '✨ Premium Collection', Subtitle: state.config.businessTagline || 'Discover timeless elegance',
                 ImageURL: state.config.heroUrl || '', LinkURL: '#products', ButtonText: 'Shop Now' }];
  }
  state.banners = banners;
  
  // Insert slides BEFORE the arrows/dots
  const dotsEl = $('#heroDots');
  $$('#heroSlider .hero-slide').forEach(s => s.remove());
  banners.forEach((b, i) => {
    const slide = document.createElement('div');
    slide.className = 'hero-slide' + (i === 0 ? ' active' : '');
    slide.style.backgroundImage = b.ImageURL ? 'url('+convertGDriveLink(b.ImageURL)+')' : 'none';
    slide.innerHTML = '<div class="hero-content">'+
      '<h1>'+safeText(b.Title || '')+'</h1>'+
      '<p>'+safeText(b.Subtitle || '')+'</p>'+
      '<button class="btn-primary" data-banner-link="'+safeText(b.LinkURL || '#products')+'"><i class="fas fa-gem"></i> '+safeText(b.ButtonText || 'Shop Now')+'</button>'+
      '</div>';
    slider.insertBefore(slide, slider.firstChild);
  });
  
  // Dots
  dotsEl.innerHTML = banners.map((_, i) => '<span class="hero-dot '+(i===0?'active':'')+'" data-hero-go="'+i+'"></span>').join('');
  if (banners.length > 1) startHeroAutoplay();
}

function goHeroSlide(i) {
  const slides = $$('#heroSlider .hero-slide');
  const dots = $$('#heroSlider .hero-dot');
  if (!slides.length) return;
  state.heroIndex = (i + slides.length) % slides.length;
  slides.forEach((s, idx) => s.classList.toggle('active', idx === state.heroIndex));
  dots.forEach((d, idx) => d.classList.toggle('active', idx === state.heroIndex));
}
function startHeroAutoplay() {
  if (state.heroTimer) clearInterval(state.heroTimer);
  state.heroTimer = setInterval(() => goHeroSlide(state.heroIndex + 1), 6000);
}

