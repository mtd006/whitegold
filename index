async function renderLoyaltyPage() {
  const wrap = $('#loyaltyContent');
  if (!state.currentUser) {
    wrap.innerHTML = '<div class="empty-state"><i class="fas fa-gift"></i><h3>Sign in to view rewards</h3><button class="btn-primary" data-open="loginModal" style="margin-top:1rem"><i class="fas fa-sign-in-alt"></i> Login</button></div>';
    return;
  }
  await loadLoyalty();
  await loadCustomerGroup();
  
  const groupsRes = await apiCall('get_customer_groups');
  const allGroups = (groupsRes.success && groupsRes.data && groupsRes.data.groups) ? groupsRes.data.groups : [];
  const currentTier = state.customerGroup && state.customerGroup.tier ? state.customerGroup.tier.GroupName : null;
  const totalSpent = state.customerGroup ? (state.customerGroup.totalSpent || 0) : 0;
  
  // Find next tier
  const sortedGroups = allGroups.filter(g => g.Status === 'Active').sort((a,b) => parseFloat(a.MinSpent||0) - parseFloat(b.MinSpent||0));
  let nextTier = null;
  for (const g of sortedGroups) {
    if (parseFloat(g.MinSpent||0) > totalSpent) { nextTier = g; break; }
  }
  
  let html =
    '<div class="loyalty-card">'+
      '<div class="label">Loyalty Balance</div>'+
      '<div class="balance">'+state.loyalty.balance+' <small style="font-size:1.1rem;font-weight:400">pts</small></div>'+
      '<div class="info">Worth <b>'+fmtMoney(state.loyalty.rupeeValue||0)+'</b> &middot; Earn '+state.loyalty.pointsPerRupee+' pt per '+CURRENCY.symbol+'1 spent</div>'+
      (currentTier ? '<div style="margin-top:1rem;font-size:13px"><i class="fas fa-medal"></i> Current Tier: <b>'+safeText(currentTier)+'</b></div>' : '')+
    '</div>';
  
  if (nextTier && totalSpent > 0) {
    const remaining = parseFloat(nextTier.MinSpent) - totalSpent;
    html += '<div class="page-card" style="background:linear-gradient(135deg,#fff,var(--bg-soft))">'+
      '<h4 style="color:var(--secondary);margin-bottom:.5rem">🎯 Next Tier: '+safeText(nextTier.GroupName)+'</h4>'+
      '<p style="color:var(--text-mid);font-size:13px">Spend '+fmtMoney(remaining)+' more to unlock '+
      (parseFloat(nextTier.DiscountPercent||0) > 0 ? '<b>'+nextTier.DiscountPercent+'% discount</b> on every order' : 'exclusive perks')+
      '</p></div>';
  }
  
  html += '<h3 style="margin:1.5rem 0 1rem;color:var(--secondary)">Membership Tiers</h3>';
  html += sortedGroups.map(g => {
    const isCurrent = currentTier === g.GroupName;
    return '<div class="tier-card '+(isCurrent ? 'current' : '')+'">'+
      '<div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.5rem">'+
        '<div>'+
          '<span class="badge-color" style="background:'+safeText(g.BadgeColor||'#888')+'"></span>'+
          '<b style="font-size:1.1rem">'+safeText(g.GroupName)+'</b>'+
          (isCurrent ? ' <span style="background:var(--primary);color:#fff;padding:2px 8px;border-radius:10px;font-size:11px;margin-left:8px">CURRENT</span>' : '')+
        '</div>'+
        '<div style="font-size:12px;color:var(--text-mid)">Spend '+fmtMoney(g.MinSpent||0)+'+</div>'+
      '</div>'+
      '<div style="margin-top:.6rem;font-size:13px;color:var(--text-mid)">'+safeText(g.Description||'')+'</div>'+
      '<div style="margin-top:.6rem;font-size:12px">'+
        (parseFloat(g.DiscountPercent||0) > 0 ? '<span style="color:var(--success);margin-right:1rem"><i class="fas fa-tag"></i> '+g.DiscountPercent+'% off all orders</span>' : '')+
        '<span style="color:var(--info)"><i class="fas fa-coins"></i> '+g.PointsMultiplier+'× points multiplier</span>'+
      '</div>'+
    '</div>';
  }).join('');
  
  // Recent ledger
  if (state.loyalty.ledger && state.loyalty.ledger.length) {
    html += '<h3 style="margin:1.5rem 0 1rem;color:var(--secondary)">Recent Activity</h3>'+
      '<div class="page-card">'+
      state.loyalty.ledger.slice(0,10).map(l =>
        '<div style="display:flex;justify-content:space-between;padding:.5rem 0;border-bottom:1px dashed #eee;font-size:13px">'+
          '<div><b>'+safeText(l.Reason||'-')+'</b><br><small style="color:var(--text-mid)">'+new Date(l.Date).toLocaleString('en-IN')+'</small></div>'+
          '<div style="font-weight:700;color:'+(l.Type==='earn' ? 'var(--success)' : 'var(--error)')+'">'+
            (l.Type==='earn' ? '+' : '-')+l.Points+' pts'+
          '</div>'+
        '</div>').join('')+
      '</div>';
  }
  
  wrap.innerHTML = html;
}

// ============== COMPLAINTS / CONTACT / NEWSLETTER ==============
async function loadComplaints() {
  if (!state.currentUser) {
    $('#complaintsList').innerHTML = '<div class="empty-state" style="padding:2rem"><i class="far fa-comment-dots"></i><p>Please login to view complaints</p></div>';
    return;
  }
  const res = await apiCall('get_customer_complaints', { customerId: state.currentUser.id });
  if (res.success && res.data && Array.isArray(res.data.complaints) && res.data.complaints.length) {
    $('#complaintsList').innerHTML = res.data.complaints.map(c => {
      const date = c['Complaint Date'] ? new Date(c['Complaint Date']).toLocaleDateString('en-IN') : 'N/A';
      const st = String(c['Complaint Status'] || 'open').toLowerCase().replace(/\s+/g,'-');
      return '<div class="order-card">'+
        '<div class="order-header">'+
          '<div><div class="order-id">Complaint #'+safeText(c.ComplaintID)+'</div><small style="color:var(--text-mid)">'+safeText(date)+'</small></div>'+
          '<span class="order-status '+safeText(st)+'">'+safeText(c['Complaint Status'] || 'Open')+'</span>'+
        '</div>'+
        '<p><b>Type:</b> '+safeText(c['Complaint Type'] || 'N/A')+'</p>'+
        '<p style="margin-top:6px"><b>Details:</b> '+safeText(c['Complaint Discription'] || '')+'</p>'+
        (c.AdminResponse ? '<div style="background:#e8f5e9;padding:8px;border-radius:8px;margin-top:8px;font-size:13px"><b>Store Response:</b> '+safeText(c.AdminResponse)+'</div>' : '')+
      '</div>';
    }).join('');
  } else {
    $('#complaintsList').innerHTML = '';
  }
}

async function loadOrdersForComplaint() {
  if (!state.currentUser) return;
  $('#complaintOrder').innerHTML = '<option value="">-- Select an Order --</option>';
  const res = await apiCall('get_customer_orders', { customerId: state.currentUser.id });
  if (res.success && res.data && Array.isArray(res.data.orders)) {
    res.data.orders.forEach(o => {
      const opt = document.createElement('option');
      opt.value = o.OrderID;
      opt.textContent = 'Order #' + o.OrderID + ' - ' + (o.OrderDate ? new Date(o.OrderDate).toLocaleDateString('en-IN') : '');
      $('#complaintOrder').appendChild(opt);
    });
  }
}

async function submitComplaint(e) {
  e.preventDefault();
  if (!state.currentUser) { openModal('loginModal'); return; }
  const res = await apiCall('submit_complaint', {
    OrderID: $('#complaintOrder').value,
    ComplaintType: $('#complaintType').value,
    ComplaintDetails: $('#complaintDetails').value
  });
  if (res.success) {
    showToast('success','Complaint submitted');
    $('#complaintForm').reset();
    loadComplaints();
  } else {
    showToast('error', (res.error && res.error.message) || 'Could not submit');
  }
}

async function submitContact(e) {
  e.preventDefault();
  const res = await apiCall('save_contact_message', {
    name: $('#contactName').value, email: $('#contactEmail').value,
    subject: $('#contactSubject').value, message: $('#contactMessage').value
  });
  if (res.success) { showToast('success','Message sent'); $('#contactForm').reset(); }
  else { showToast('error', (res.error && res.error.message) || 'Could not send'); }
}

async function subscribeNewsletter(email, source) {
  const res = await apiCall('subscribe_newsletter', { email, source: source || 'website' });
  if (res.success) showToast('success', res.message || 'Subscribed!');
  else showToast('error', (res.error && res.error.message) || 'Could not subscribe');
  return res.success;
}

function setMobileMenuIcon(open) {
  const btn = $('#mobileMenuBtn');
  if (!btn) return;
  btn.innerHTML = open ? '<i class="fas fa-xmark"></i>' : '<i class="fas fa-bars"></i>';
  btn.setAttribute('aria-expanded', open ? 'true' : 'false');
}
function closeMobileNav() {
  const nl = $('#navLinks');
  if (nl && nl.classList.contains('mobile-active')) {
    nl.classList.remove('mobile-active');
    setMobileMenuIcon(false);
  }
}

function showPage(page) {
  $$('.page-section').forEach(s => s.classList.remove('active'));
  const target = $('#'+page+'Page');
  if (target) target.classList.add('active');
  if (page === 'orders') loadOrders();
  if (page === 'complaints') { loadComplaints(); loadOrdersForComplaint(); }
  if (page === 'wishlist') renderWishlistPage();
  if (page === 'loyalty') renderLoyaltyPage();
  if (page === 'profile') loadProfile();
  if (page === 'account') loadAccount();
  window.scrollTo({ top: 0, behavior: 'smooth' });
  closeMobileNav();
}

