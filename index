function accCloseAddress() {
  const f = $('#accAddrForm');
  if (f) { f.style.display = 'none'; f.innerHTML = ''; }
  ACC.editAddressId = null;
}

async function accSaveAddress() {
  const payload = {
    label:     $('#afLabel').value,
    fullName:  $('#afName').value.trim(),
    phone:     $('#afPhone').value.trim(),
    line1:     $('#afLine1').value.trim(),
    line2:     $('#afLine2').value.trim(),
    landmark:  $('#afLandmark').value.trim(),
    city:      $('#afCity').value.trim(),
    state:     $('#afState').value.trim(),
    pincode:   $('#afPin').value.trim(),
    country:   $('#afCountry').value.trim(),
    isDefault: $('#afDefault').checked
  };

  if (!payload.fullName) return accAlert('accAddrAlert', 'error', 'Recipient name is required');
  if (!payload.phone)    return accAlert('accAddrAlert', 'error', 'Contact phone is required');
  if (!payload.line1)    return accAlert('accAddrAlert', 'error', 'Address line 1 is required');
  if (!payload.city)     return accAlert('accAddrAlert', 'error', 'City is required');
  if (!payload.pincode)  return accAlert('accAddrAlert', 'error', 'Postal / PIN code is required');

  const btn = $('#afSave');
  btn.disabled = true;
  btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving…';

  let res;
  if (ACC.editAddressId) {
    payload.addressId = ACC.editAddressId;
    res = await apiCall('update_my_address', { address: payload });
  } else {
    res = await apiCall('add_my_address', { address: payload });
  }

  btn.disabled = false;
  btn.innerHTML = '<i class="fas fa-floppy-disk"></i> Save Address';

  if (res && res.success) {
    accCloseAddress();
    showToast('success', ACC.editAddressId ? 'Address updated' : 'Address saved');
    renderAddressBook();
  } else {
    accAlert('accAddrAlert', 'error', (res && res.error && res.error.message) || 'Could not save address');
  }
}

async function accDeleteAddress(id) {
  if (!confirm('Remove this address from your address book?')) return;
  const res = await apiCall('delete_my_address', { addressId: id });
  if (res && res.success) { showToast('success', 'Address removed'); renderAddressBook(); }
  else showToast('error', (res && res.error && res.error.message) || 'Could not remove address');
}

async function accSetDefaultAddress(id) {
  const res = await apiCall('set_default_address', { addressId: id });
  if (res && res.success) { showToast('success', 'Default address updated'); renderAddressBook(); }
  else showToast('error', (res && res.error && res.error.message) || 'Could not update default');
}

