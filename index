async function handleLogin(e) {
  e.preventDefault();
  const email = $('#loginEmail').value.trim(), password = $('#loginPassword').value;
  if (!isValidEmail(email)) return showToast('error','Please enter a valid email');
  if (!password) return showToast('error','Password required');
  const btn = $('#loginBtn');
  btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Logging in…';
  const res = await apiCall('login', { email, password });
  btn.disabled = false; btn.innerHTML = '<i class="fas fa-sign-in-alt"></i> Login';
  if (res.success) {
    state.currentUser = res.data.customer; state.isAdmin = false;
    closeModal('loginModal'); $('#loginForm').reset();
    showToast('success', 'Welcome back, ' + state.currentUser.name + '!');
    await loadCart(); await loadWishlist(); await loadLoyalty(); await loadCustomerGroup();
    renderUserMenu();
  } else {
    showToast('error', (res.error && res.error.message) || res.message || 'Login failed');
  }
}

async function handleRegister(e) {
  e.preventDefault();
  const data = {
    name: $('#registerName').value.trim(), email: $('#registerEmail').value.trim(),
    password: $('#registerPassword').value, phone: $('#registerPhone').value.trim(),
    address: $('#registerAddress').value.trim()
  };
  if (data.name.length < 2)        return showToast('error','Please enter your name');
  if (!isValidEmail(data.email))   return showToast('error','Invalid email');
  if (data.password.length < 6)    return showToast('error','Password must be at least 6 characters');
  const btn = $('#registerBtn');
  btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Creating…';
  const res = await apiCall('register', data);
  btn.disabled = false; btn.innerHTML = '<i class="fas fa-user-plus"></i> Create Account';
  if (res.success) {
    state.currentUser = res.data.customer;
    closeModal('registerModal'); $('#registerForm').reset();
    showToast('success', 'Welcome aboard! +50 bonus points awarded.');
    await loadCart(); await loadLoyalty();
    renderUserMenu();
  } else {
    showToast('error', (res.error && res.error.message) || 'Registration failed');
  }
}

/** Navigate to the Admin Dashboard.
 *  IMPORTANT: the storefront runs inside the GAS iframe sandbox, so
 *  window.location.pathname is the googleusercontent sandbox path — NOT the
 *  deployed /macros/s/.../exec URL. Always navigate the TOP window to the
 *  injected SCRIPT_URL. */
function openAdminDashboard(url) {
  const target = url || (SCRIPT_URL + '?page=admin');
